{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "strict": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "target": "ES2021",
    "paths": {
      "@shared/*": ["../../shared/src/*"]
    }
  }
}
